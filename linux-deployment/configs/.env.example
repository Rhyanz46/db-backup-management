# PostgreSQL Backup Management System - Environment Variables
# Copy this file to .env and customize for your environment

# =============================================
# DATABASE CONFIGURATION
# =============================================
# Default PostgreSQL connection settings
DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=5432
DEFAULT_DB_NAME=backup_db
DEFAULT_DB_USER=postgres

# =============================================
# APPLICATION SETTINGS
# =============================================
# Application name (used for logging and service identification)
APP_NAME=backup-service
APP_VERSION=0.1.0

# Working directory
APP_WORKDIR=/opt/backup-service

# Log level (debug, info, warn, error)
RUST_LOG=info

# Port for REST API server
REST_PORT=8080
REST_HOST=0.0.0.0

# =============================================
# DIRECTORY PATHS
# =============================================
# Installation directory
INSTALL_DIR=/opt/backup-service

# Configuration directory
CONFIG_DIR=/opt/backup-service/config

# Backup storage directory
BACKUP_DIR=/opt/backup-service/backup

# Log directory
LOG_DIR=/opt/backup-service/logs

# Temporary directory for processing
TEMP_DIR=/tmp/backup-service

# =============================================
# SECURITY SETTINGS
# =============================================
# Service user and group
SERVICE_USER=backup-service
SERVICE_GROUP=backup-service

# Enable debug mode (more verbose logging)
DEBUG_MODE=false

# Enable detailed backtrace for errors
RUST_BACKTRACE=1

# =============================================
# BACKUP SETTINGS
# =============================================
# Default backup compression (true/false)
COMPRESS_BACKUPS=false

# Maximum number of backups to retain
MAX_BACKUPS_RETAINED=30

# Backup retention period in days
BACKUP_RETENTION_DAYS=30

# Default schemas to backup (comma-separated)
DEFAULT_SCHEMAS=public

# =============================================
# NOTIFICATION SETTINGS
# =============================================
# Enable Telegram notifications
TELEGRAM_ENABLED=false

# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID for notifications
TELEGRAM_CHAT_ID=

# =============================================
# PERFORMANCE SETTINGS
# =============================================
# Maximum concurrent backup operations
MAX_CONCURRENT_BACKUPS=1

# Database connection timeout in seconds
DB_CONNECTION_TIMEOUT=30

# Backup timeout in seconds
BACKUP_TIMEOUT=3600

# Memory limit for backup process (MB)
BACKUP_MEMORY_LIMIT=1024

# =============================================
# LOGGING CONFIGURATION
# =============================================
# Log file rotation settings
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=5
LOG_ROTATION=daily

# Enable structured logging
STRUCTURED_LOGGING=false

# Log to both file and systemd journal
LOG_TO_JOURNAL=true

# =============================================
# INTEGRATION SETTINGS
# =============================================
# Webhook URL for external notifications
WEBHOOK_URL=

# SMTP server for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=backup-service@company.com

# Slack webhook URL
SLACK_WEBHOOK_URL=

# =============================================
# MONITORING
# =============================================
# Enable metrics collection
ENABLE_METRICS=true

# Metrics endpoint
METRICS_PORT=9090

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=60

# =============================================
# DEVELOPMENT/DEBUG
# =============================================
# Enable development mode (additional logging and features)
DEVELOPMENT_MODE=false

# Enable profiling
ENABLE_PROFILING=false

# Test database connection on startup
TEST_CONNECTION_ON_STARTUP=true

# =============================================
# ADVANCED OPTIONS
# =============================================
# Custom OpenSSL directory (if not using system default)
OPENSSL_DIR=

# Custom pg_dump path (if not in PATH)
PG_DUMP_PATH=

# Custom psql path (if not in PATH)
PSQL_PATH=

# Additional pg_dump options
PG_DUMP_EXTRA_ARGS=

# Additional psql options
PSQL_EXTRA_ARGS=

# =============================================
# AUTO-GENERATED SETTINGS (DO NOT MODIFY)
# =============================================
# System detected settings
DETECTED_OS=linux
DETECTED_ARCH=x86_64
DETECTED_DISTRO=

# Build timestamp
BUILD_TIMESTAMP=
BUILD_COMMIT=