# PostgreSQL Backup Management System - Production Environment
# Optimized for production deployment

# =============================================
# DATABASE CONFIGURATION
# =============================================
DEFAULT_DB_HOST=192.168.1.100
DEFAULT_DB_PORT=5432
DEFAULT_DB_NAME=production_app
DEFAULT_DB_USER=backup_service

# =============================================
# APPLICATION SETTINGS
# =============================================
APP_NAME=backup-service
APP_VERSION=0.1.0
APP_WORKDIR=/opt/backup-service

RUST_LOG=info
REST_PORT=8080
REST_HOST=0.0.0.0

# =============================================
# DIRECTORY PATHS
# =============================================
INSTALL_DIR=/opt/backup-service
CONFIG_DIR=/opt/backup-service/config
BACKUP_DIR=/opt/backup-service/backup
LOG_DIR=/var/log/backup-service
TEMP_DIR=/tmp/backup-service

# =============================================
# SECURITY SETTINGS
# =============================================
SERVICE_USER=backup-service
SERVICE_GROUP=backup-service
DEBUG_MODE=false
RUST_BACKTRACE=0

# =============================================
# BACKUP SETTINGS
# =============================================
COMPRESS_BACKUPS=false
MAX_BACKUPS_RETAINED=60
BACKUP_RETENTION_DAYS=90
DEFAULT_SCHEMAS=public,data,analytics,reports

# =============================================
# NOTIFICATION SETTINGS
# =============================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1234567890123

# =============================================
# PERFORMANCE SETTINGS
# =============================================
MAX_CONCURRENT_BACKUPS=2
DB_CONNECTION_TIMEOUT=45
BACKUP_TIMEOUT=7200
BACKUP_MEMORY_LIMIT=2048

# =============================================
# LOGGING CONFIGURATION
# =============================================
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_ROTATION=daily
STRUCTURED_LOGGING=false
LOG_TO_JOURNAL=true

# =============================================
# MONITORING
# =============================================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# =============================================
# PRODUCTION SPECIFIC
# =============================================
DEVELOPMENT_MODE=false
ENABLE_PROFILING=false
TEST_CONNECTION_ON_STARTUP=true