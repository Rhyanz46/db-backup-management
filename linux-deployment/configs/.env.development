# PostgreSQL Backup Management System - Development Environment
# Optimized for development and testing

# =============================================
# DATABASE CONFIGURATION
# =============================================
DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=5432
DEFAULT_DB_NAME=dev_app
DEFAULT_DB_USER=postgres

# =============================================
# APPLICATION SETTINGS
# =============================================
APP_NAME=backup-service
APP_VERSION=0.1.0
APP_WORKDIR=/home/user/projects/backup-service

RUST_LOG=debug
REST_PORT=8081
REST_HOST=127.0.0.1

# =============================================
# DIRECTORY PATHS
# =============================================
INSTALL_DIR=/home/user/projects/backup-service
CONFIG_DIR=/home/user/projects/backup-service/config
BACKUP_DIR=/home/user/projects/backup-service/backup
LOG_DIR=/home/user/projects/backup-service/logs
TEMP_DIR=/tmp/backup-service

# =============================================
# SECURITY SETTINGS
# =============================================
SERVICE_USER=$(whoami)
SERVICE_GROUP=$(id -gn)
DEBUG_MODE=true
RUST_BACKTRACE=1

# =============================================
# BACKUP SETTINGS
# =============================================
COMPRESS_BACKUPS=false
MAX_BACKUPS_RETAINED=10
BACKUP_RETENTION_DAYS=7
DEFAULT_SCHEMAS=public

# =============================================
# NOTIFICATION SETTINGS
# =============================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================
# PERFORMANCE SETTINGS
# =============================================
MAX_CONCURRENT_BACKUPS=1
DB_CONNECTION_TIMEOUT=10
BACKUP_TIMEOUT=300
BACKUP_MEMORY_LIMIT=512

# =============================================
# LOGGING CONFIGURATION
# =============================================
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=3
LOG_ROTATION=hourly
STRUCTURED_LOGGING=true
LOG_TO_JOURNAL=false

# =============================================
# DEVELOPMENT/DEBUG
# =============================================
DEVELOPMENT_MODE=true
ENABLE_PROFILING=true
TEST_CONNECTION_ON_STARTUP=true

# =============================================
# TESTING SPECIFIC
# =============================================
# Use test database
TEST_DB_NAME=test_app

# Test backup directory
TEST_BACKUP_DIR=/tmp/test-backups

# Enable verbose output for tests
TEST_VERBOSE=true